{
  "name": "skill-rsi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "skill-rsi": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "start": "node src/cli.js",
    "server": "node src/server.js",
    "dev:ui": "vite --config ui/vite.config.js --host 127.0.0.1",
    "build:ui": "vite build --config ui/vite.config.js",
    "preview:ui": "vite preview --config ui/vite.config.js --host 127.0.0.1",
    "plugin:validate": "node scripts/skill-rsi-plugin-validate.mjs",
    "plugin:smoke": "node scripts/skill-rsi-plugin-smoke.mjs",
    "plugin:check": "npm run plugin:validate && npm run plugin:smoke && npm test && npm run build:ui && git diff --check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.14"
  }
}
