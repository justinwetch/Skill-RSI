%%{init: {"theme":"base","themeVariables":{"background":"#F5F5F7","mainBkg":"#FFFFFF","primaryColor":"#FFFFFF","primaryTextColor":"#1D1D1F","primaryBorderColor":"#D2D2D7","lineColor":"#6E6E73","secondaryColor":"#DCEAF5","tertiaryColor":"#E7F2E8","textColor":"#1D1D1F","clusterBkg":"#FFFFFF","clusterBorder":"#D2D2D7","fontFamily":"DM Sans, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"}}}%%
flowchart TB
    goal(["Skill goal"]):::input
    research["Research packet"]
    ontology[("Ontology guardrail")]:::data
    deconstruct["Deconstruct champion"]
    plan["Plan one experiment"]
    challenger["Generate challenger"]
    review{"Preflight review"}
    eval["Evaluate vs champion"]
    promote{"Policy gate"}
    champion[("Champion skill")]:::champion
    history[("History and next loop plan")]:::memory
    stop(["Stop when user stops"])

    subgraph setup["Map the work"]
      direction TB
      goal --> research --> ontology
    end

    subgraph experiment["Run one controlled experiment"]
      direction TB
      deconstruct --> plan --> challenger --> review
      review -->|"passes"| eval --> promote
      review -->|"bounded revision"| challenger
    end

    subgraph memory["Decide and remember"]
      direction TB
      champion --> history --> stop
    end

    ontology --> deconstruct
    champion -. "control" .-> deconstruct
    promote -->|"promote challenger"| champion
    promote -->|"hold champion"| champion
    promote --> history
    history -. "next loop context" .-> deconstruct

    classDef input fill:#F5F5F7,stroke:#F5F5F7,color:#161617,stroke-width:1px
    classDef data fill:#7FA7C922,stroke:#7FA7C9,color:#1D1D1F,stroke-width:1px
    classDef champion fill:#68FF9130,stroke:#68FF91,color:#1D1D1F,stroke-width:2px
    classDef memory fill:#76A77C2A,stroke:#76A77C,color:#1D1D1F,stroke-width:1px
