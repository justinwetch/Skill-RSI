flowchart TB
    champion[("Champion<br/>control")]:::champion
    plan["Experiment plan<br/>one focused mutation"]:::plan
    challenger[("Challenger<br/>treatment")]:::challenger

    champion --> preserve["Preserve unrelated behavior"]
    plan --> mutate["Change one parameter family"]
    preserve --> challenger
    mutate --> challenger

    prompts[["Same eval prompts"]]:::eval
    criteria[["Same criteria"]]:::eval
    judge[["Same judge policy"]]:::eval

    champion --> prompts
    challenger --> prompts
    prompts --> criteria --> judge --> decision{"Did treatment win without regression?"}
    decision -->|"yes"| promote["Promote challenger"]:::win
    decision -->|"no"| hold["Keep champion"]:::loss

    classDef champion fill:#68FF9130,stroke:#68FF91,color:#1D1D1F,stroke-width:2px
    classDef challenger fill:#D39A5F30,stroke:#D39A5F,color:#1D1D1F,stroke-width:2px
    classDef plan fill:#7FA7C930,stroke:#7FA7C9,color:#1D1D1F
    classDef eval fill:#FFFFFF,stroke:#B8B8BD,color:#1D1D1F
    classDef win fill:#68FF9130,stroke:#68FF91,color:#1D1D1F
    classDef loss fill:#FF50682A,stroke:#FF5068,color:#1D1D1F
