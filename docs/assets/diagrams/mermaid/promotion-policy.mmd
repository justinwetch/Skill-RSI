%%{init: {"theme":"base","themeVariables":{"background":"#F5F5F7","mainBkg":"#FFFFFF","primaryColor":"#FFFFFF","primaryTextColor":"#1D1D1F","primaryBorderColor":"#D2D2D7","lineColor":"#6E6E73","secondaryColor":"#DCEAF5","tertiaryColor":"#E7F2E8","textColor":"#1D1D1F","clusterBkg":"#FFFFFF","clusterBorder":"#D2D2D7","fontFamily":"DM Sans, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"}}}%%
flowchart TD
    raw[("Raw eval results")]:::data
    score{"Score threshold<br/>cleared?"}
    margin{"Win margin<br/>cleared?"}
    stable{"Stable-prompt<br/>regressions?"}
    complete{"Enough evals<br/>completed?"}
    analyst["Analyst interprets confidence, noise, and risk"]:::process
    outcome{"Final recommendation"}
    promote["Promote challenger"]:::win
    keep["Keep champion"]:::hold
    inconclusive["Record inconclusive run"]:::warn
    redirect["Request different experiment"]:::warn

    raw --> score
    score -->|"no"| keep
    score -->|"yes"| margin
    margin -->|"no"| keep
    margin -->|"yes"| stable
    stable -->|"critical regression"| keep
    stable -->|"no critical regression"| complete
    complete -->|"no"| inconclusive
    complete -->|"yes"| analyst --> outcome
    outcome --> promote
    outcome --> keep
    outcome --> inconclusive
    outcome --> redirect

    classDef data fill:#7FA7C922,stroke:#7FA7C9,color:#1D1D1F
    classDef process fill:#F5F5F7,stroke:#F5F5F7,color:#161617
    classDef win fill:#68FF9130,stroke:#68FF91,color:#1D1D1F,stroke-width:2px
    classDef hold fill:#FFFFFF,stroke:#B8B8BD,color:#1D1D1F
    classDef warn fill:#D6A84F30,stroke:#D6A84F,color:#1D1D1F
